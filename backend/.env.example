# Copy to backend/.env and fill in. .env is gitignored — never commit real values.
DB_USER=
DB_PASSWORD=
DB_NAME=livs

# Optional; these are the defaults.
#DB_HOST=localhost
#DB_PORT=3306

# Browser origins allowed to call this API, comma-separated. Defaults to the
# local dev servers below. Set this to the real frontend origin on the Pi.
#CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Only used by `python app.py`; gunicorn takes its bind address from the
# systemd unit instead.
#HOST=0.0.0.0
#PORT=5000

# Absolute path to the music library root. Required by the music service.
MUSIC_DIR=/mnt/media/music

# Jellyfin, for the cinema section. Create the API key in Dashboard -> API Keys
# and read the user id from Dashboard -> Users. scripts/jellyfin-dev.sh prints
# all three for a local development server.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# Absolute path to the photos root, a subdirectory of the mount as with music.
# The site writes here: uploads land in YYYY/MM/. Thumbnails are cached in
# PHOTOS_THUMBS_DIR, default PHOTOS_DIR/.thumbnails.
PHOTOS_DIR=/mnt/media/photos
#PHOTOS_THUMBS_DIR=

# The login. SECRET_KEY signs the session cookie: any long random string, and
# keep it, or a restart logs everyone out. SITE_PASSWORD_HASH comes from
#   flask --app app hash-password
# SITE_HTTPS=1 marks the cookie Secure; set it once the site is behind TLS.
SECRET_KEY=
SITE_PASSWORD_HASH=
SITE_HTTPS=0
