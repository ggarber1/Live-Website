[Unit]
Description=Liv's website API
# Wait for the database, otherwise the first requests after a reboot fail.
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
# EDIT: the user that owns the checkout on the Pi.
User=pi
Group=pi

# EDIT: where the repo lives on the Pi. WorkingDirectory must be backend/ —
# imports resolve relative to it (`from app import app`, `from api import ...`).
WorkingDirectory=/home/pi/livs_website/backend
EnvironmentFile=/home/pi/livs_website/backend/.env
# gthread, not the default sync worker. Streaming a track holds the worker
# for the whole transfer — a 40 MB FLAC over weak wifi is minutes — and with
# sync workers three listeners would block every other request, including
# /todo. Threads let one process hold several stalled transfers at once.
# Phase 3 moves the bytes out of Python entirely via X-Accel-Redirect.
ExecStart=/home/pi/livs_website/backend/venv/bin/gunicorn \
    --workers 3 \
    --worker-class gthread \
    --threads 8 \
    --bind 0.0.0.0:5000 \
    --access-logfile - \
    --error-logfile - \
    app:app

Restart=on-failure
RestartSec=5

# The API only needs to read its own checkout and talk to MySQL's socket.
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/livs_website

[Install]
WantedBy=multi-user.target
